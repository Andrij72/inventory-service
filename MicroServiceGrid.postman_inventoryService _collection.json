{
  "info": {
    "name": "Inventory Service API",
    "_postman_id": "inventory-service",
    "description": "Test Inventory microservice endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reserve Stock",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"order-123\",\n  \"skuCode\": \"sku-001\",\n  \"quantity\": 5\n}"
        },
        "url": {"raw": "http://localhost:8080/api/inventory/reserve", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","inventory","reserve"]}
      }
    },
    {
      "name": "Confirm Reservation",
      "request": {
        "method": "POST",
        "url": {"raw": "http://localhost:8080/api/inventory/confirm?orderId=order-123", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","inventory","confirm"], "query":[{"key":"orderId","value":"order-123"}]}
      }
    },
    {
      "name": "Cancel Reservation",
      "request": {
        "method": "POST",
        "url": {"raw": "http://localhost:8080/api/inventory/cancel?orderId=order-123", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","inventory","cancel"], "query":[{"key":"orderId","value":"order-123"}]}
      }
    },
    {
      "name": "Check Stock",
      "request": {
        "method": "GET",
        "url": {"raw": "http://localhost:8080/api/inventory/check?skuCode=sku-001&quantity=5", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","inventory","check"], "query":[{"key":"skuCode","value":"sku-001"},{"key":"quantity","value":"5"}]}
      }
    }
  ]
}
